{
  "manifest_version": 3,
  "name": "CityU TronClass Plugin",
  "version": "0.3.0",
  "description": "在本地聚合澳门城市大学 TronClass 的出勤、待提交任务、课程文件与匿名城大战绩报告。",
  "permissions": ["downloads", "tabs", "storage"],
  "host_permissions": [
    "https://tronclass.cityu.edu.mo/*",
    "https://tcmedia.cityu.edu.mo/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 CityU TronClass Plugin"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
